HOST=0.0.0.0
PORT=1341

# Public origin the CMS is reached on, e.g. https://cms.example.org. Required in
# any deployment sitting behind a reverse proxy (Dokploy/Traefik) so Strapi emits
# correct absolute URLs and scopes admin cookies to the real host. Leave blank
# locally. IS_PROXIED defaults to true and only matters when X-Forwarded-* headers
# are present, so it is safe to leave alone.
PUBLIC_URL=
IS_PROXIED=true
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (Postgres only)
# DATABASE_CLIENT is informational — config/database.ts hardcodes `client: 'postgres'`
# and never reads this value.
DATABASE_CLIENT=postgres
# Local: connect over the internet via the server's public IP + external port.
# Deployed on the same Docker network: use the internal hostname instead,
#   e.g. postgresql://postgres:<password>@climate-facility-db-gv8f9t:5432/postgres
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_SSL=false

# Media uploads (Cloudinary) — used by the upload provider in config/plugins.ts
# and by scripts/upload-page-media.mjs.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Optional overrides — all have working defaults in config/, set only to tune.
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# WEBHOOKS_POPULATE_RELATIONS=false
